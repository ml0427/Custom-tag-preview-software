{
  "name": "client",
  "private": true,
  "version": "0.147.0",
  "type": "module",
  "scripts": {
    "tauri:dev": "tauri dev",
    "pretauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-tauri-build-blockers.ps1",
    "tauri:build": "node scripts/tauri-build.cjs",
    "dev": "vite --host 127.0.0.1 --strictPort",
    "prebuild": "node scripts/stamp-build.cjs",
    "stamp-build": "node scripts/stamp-build.cjs --force",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:css": "stylelint \"src/**/*.{vue,css}\"",
    "lint:css:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "version:set": "node scripts/release-version.cjs",
    "version:check": "node scripts/release-version.cjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0-rc.18",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.10.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.5"
  }
}
